{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "AutoLink.api/index.js": {
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/AutoLink.api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}